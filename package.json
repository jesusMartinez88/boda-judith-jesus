{
  "name": "boda-judith-jesus",
  "version": "1.13.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration production",
    "dev": "ng serve --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /boda-judith-jesus/",
    "deploy": "ng deploy --repo=https://github.com/jesusMartinez88/boda-judith-jesus.git --base-href=/boda-judith-jesus/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:security": "vitest run src/app/services/auth-security.spec.ts src/app/services/security-headers.spec.ts",
    "version:sync": "node scripts/update-version.js",
    "version:patch": "npm version patch && npm run version:sync",
    "version:minor": "npm version minor && npm run version:sync",
    "version:major": "npm version major && npm run version:sync",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "engines": {
    "node": "24.18.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.0.6",
    "@angular/ssr": "^22.1.4",
    "aos": "^2.3.4",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@eslint/js": "^10.0.1",
    "@ngx-env/builder": "^21.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/aos": "^3.0.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "7.28.0"
  }
}

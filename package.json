{
  "name": "boda-judith-jesus",
  "version": "1.10.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration production",
    "dev": "ng serve --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /boda-judith-jesus/",
    "deploy": "ng deploy --repo=https://github.com/jesusMartinez88/boda-judith-jesus.git --base-href=/boda-judith-jesus/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "version:sync": "node scripts/update-version.js",
    "version:patch": "npm version patch && npm run version:sync",
    "version:minor": "npm version minor && npm run version:sync",
    "version:major": "npm version major && npm run version:sync",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "24.16.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "aos": "^2.3.4",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-angular": "^1.0.0",
    "prettier": "^3.8.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@eslint/js": "^10.0.1",
    "@ngx-env/builder": "^21.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/aos": "^3.0.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.3",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "undici": ">=7.24.5",
    "picomatch": ">=4.0.4"
  }
}
